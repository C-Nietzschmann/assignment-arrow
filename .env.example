# ============================================================================
# Assignment Arrow - environment settings
#
# THE STATIC SITE NEEDS NONE OF THIS. If you deployed with render.yaml, or as
# a Render Static Site, stop here: there is nothing to configure and nothing
# to pay for. This file only matters if you later turn on the optional
# question generator in server/.
#
# Render has no "import .env" button. Open your service -> Environment ->
# "Add from .env" and paste the lines below, or add them one at a time.
#
# NEVER commit a filled-in .env. This repository is public; a real key
# pasted into it is stolen within minutes by automated scanners.
# ============================================================================

# Your Anthropic API key. Without it the server still serves the site
# perfectly - the generator button simply stays hidden.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# A shared word your class types once to unlock generation. Leave it blank
# and anyone who finds the URL can spend your credit.
SCHOOL_ACCESS_CODE=change-me

# Stop one student in a loop from emptying the account.
# Questions per browser per hour:
RATE_LIMIT_PER_HOUR=15

# Hard ceiling on questions generated per day across everyone. When it is
# reached the generator switches off until midnight UTC.
DAILY_QUESTION_CAP=300

# Which model writes the questions. claude-opus-5 gives the best questions;
# claude-sonnet-5 costs roughly a third as much.
ANTHROPIC_MODEL=claude-opus-5

# Render sets this for you. Only needed when running locally.
PORT=10000
